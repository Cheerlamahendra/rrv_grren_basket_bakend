# ==============================================================================
# RRV GREEN BASKET — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================

# Database Configuration (MySQL 9)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_secure_mysql_password

# Microservice Database URLs
REVIEW_DB_URL=jdbc:mysql://localhost:3306/review_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&createDatabaseIfNotExist=true
STORE_DB_URL=jdbc:mysql://localhost:3306/store_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&createDatabaseIfNotExist=true
PRODUCT_DB_URL=jdbc:mysql://localhost:3306/product_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&createDatabaseIfNotExist=true
WISHLIST_DB_URL=jdbc:mysql://localhost:3306/wishlist_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&createDatabaseIfNotExist=true

# Service Ports
DISCOVERY_SERVER_PORT=8761
CONFIG_SERVER_PORT=8888
GATEWAY_PORT=8080
AUTH_SERVICE_PORT=8081
CUSTOMER_SERVICE_PORT=8082
PRODUCT_SERVICE_PORT=8084
INVENTORY_SERVICE_PORT=8085
WISHLIST_SERVICE_PORT=8087
REVIEW_SERVICE_PORT=8088
PAYMENT_SERVICE_PORT=8089
STORE_SERVICE_PORT=8090

# JWT & Security Configuration
# 256-bit Hex secret key for HS256 HMAC JWT verification
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
INTERNAL_SERVICE_SECRET=c8f7e2d1a5b49382716054321fedcba9876543210abcdef0123456789abcdef0

# Downstream Microservice URLs
EUREKA_CLIENT_SERVICEURL_DEFAULTZONE=http://localhost:8761/eureka/
CONFIG_SERVER_URL=http://localhost:8888
PRODUCT_SERVICE_URL=http://localhost:8084
AUTH_SERVICE_URL=http://localhost:8081

# AWS S3 Image Storage & CloudFront CDN
# Storage provider: 'aws-s3' for production AWS S3, 'mock' for local offline testing
AWS_S3_PROVIDER=aws-s3
AWS_REGION=ap-southeast-2
AWS_S3_BUCKET=vegetable-ecommerce-product-images-2026
AWS_CLOUDFRONT_DOMAIN=https://cdn.rrvgreenbasket.com

# AWS IAM Credentials (Leave blank if running on AWS EC2/ECS/EKS with IAM Roles)
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
