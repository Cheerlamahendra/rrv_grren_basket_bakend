          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": {
              "raw": "{{gatewayUrl}}/api/cart",
              "host": ["{{gatewayUrl}}"],
              "path": ["api", "cart"]
            }
