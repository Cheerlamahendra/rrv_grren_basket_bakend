  "item": [
    {
      "name": "Cart Core Operations",
      "item": [
        {
          "name": "1. Get Cart",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "var jsonData = pm.response.json();",
                  "pm.test('Response envelope valid', function () { pm.expect(jsonData.success).to.be.true; });",
                  "pm.test('Cart has publicId and items', function () { pm.expect(jsonData.data.cartPublicId).to.be.a('string'); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": {
              "raw": "{{gatewayUrl}}/api/cart",
              "host": ["{{gatewayUrl}}"],
              "path": ["api", "cart"]
            }
          }
        },
        {
          "name": "2. Add Product",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201', function () { pm.response.to.have.status(201); });",
                  "var jsonData = pm.response.json();",
                  "pm.test('Product added to cart', function () { pm.expect(jsonData.data.items.length).to.be.above(0); });",
                  "if (jsonData.data.items && jsonData.data.items.length > 0) {",
                  "  pm.collectionVariables.set('cartItemPublicId', jsonData.data.items[0].itemPublicId);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productPublicId\": \"{{productPublicId}}\",\n  \"quantity\": 2.000,\n  \"unitOfMeasure\": \"KG\"\n}"
            },
            "url": {
              "raw": "{{gatewayUrl}}/api/cart/items",
              "host": ["{{gatewayUrl}}"],
              "path": ["api", "cart", "items"]
            }
          }
        },
        {
          "name": "3. Add Duplicate Product and Verify Merge",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201', function () { pm.response.to.have.status(201); });",
                  "var jsonData = pm.response.json();",
                  "pm.test('Duplicate product quantity merged', function () {",
                  "  var item = jsonData.data.items.find(i => i.productPublicId === pm.collectionVariables.get('productPublicId'));",
                  "  pm.expect(item).to.not.be.undefined;",
                  "  pm.expect(item.quantity).to.be.above(2.000);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productPublicId\": \"{{productPublicId}}\",\n  \"quantity\": 1.000,\n  \"unitOfMeasure\": \"KG\"\n}"
            },
            "url": {
              "raw": "{{gatewayUrl}}/api/cart/items",
              "host": ["{{gatewayUrl}}"],
              "path": ["api", "cart", "items"]
            }
          }
        },
        {
          "name": "4. Update Quantity (PATCH)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "var jsonData = pm.response.json();",
                  "pm.test('Quantity updated successfully', function () {",
                  "  var item = jsonData.data.items.find(i => i.itemPublicId === pm.collectionVariables.get('cartItemPublicId'));",
                  "  pm.expect(item.quantity).to.eql(4);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantity\": 4.000\n}"
            },
            "url": {
              "raw": "{{gatewayUrl}}/api/cart/items/{{cartItemPublicId}}",
              "host": ["{{gatewayUrl}}"],
              "path": ["api", "cart", "items", "{{cartItemPublicId}}"]
            }
          }
        },
        {
          "name": "5. Remove Item",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "var jsonData = pm.response.json();",
                  "pm.test('Item removed from cart', function () {",
                  "  var found = jsonData.data.items.some(i => i.itemPublicId === pm.collectionVariables.get('cartItemPublicId'));",
                  "  pm.expect(found).to.be.false;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
