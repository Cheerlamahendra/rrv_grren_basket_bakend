                  "pm.test('Validation response structure valid', function () {",
                  "  pm.expect(jsonData.data).to.have.property('valid');",
                  "  pm.expect(jsonData.data).to.have.property('currentSubtotal');",
                  "  pm.expect(jsonData.data).to.have.property('validationMessages');",
                  "});"
