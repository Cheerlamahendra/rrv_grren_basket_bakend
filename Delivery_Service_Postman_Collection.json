{
  "info": {
    "name": "RRV Green Basket - Delivery Service API",
    "_postman_id": "a1b2c3d4-e5f6-7a8b-9c0d-1e2f3a4b5c6d",
    "description": "Postman Collection for RRV Green Basket Delivery Service (Port 8090 / Gateway Port 8080). Includes complete Hybrid Delivery Validation (Polygon + PIN code + City + State), Admin Delivery Zone Management, and Customer Availability Checks with backward compatibility.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "PASTE_ADMIN_BEARER_TOKEN",
      "type": "string"
    },
    {
      "key": "customerToken",
      "value": "PASTE_CUSTOMER_BEARER_TOKEN",
      "type": "string"
    },
    {
      "key": "zoneId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Admin Delivery Zone Management",
      "item": [
        {
          "name": "Create Delivery Zone (Polygon + City + State + PIN)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.publicId) {",
                  "    pm.collectionVariables.set('zoneId', jsonData.data.publicId);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"zoneName\": \"Kurnool Central Zone\",\n  \"zoneCode\": \"KUR-CENTRAL-01\",\n  \"description\": \"Central delivery coverage for Kurnool city\",\n  \"city\": \"Kurnool\",\n  \"state\": \"Andhra Pradesh\",\n  \"pincode\": \"518001\",\n  \"pincodes\": [\"518001\", \"518002\"],\n  \"deliveryCharge\": 30.00,\n  \"minimumOrderAmount\": 199.00,\n  \"freeDeliveryThreshold\": 499.00,\n  \"estimatedDeliveryTime\": \"NEXT_DAY\",\n  \"active\": true,\n  \"boundary\": {\n    \"type\": \"Polygon\",\n    \"coordinates\": [\n      [\n        [78.0300, 15.8200],\n        [78.0500, 15.8200],\n        [78.0500, 15.8400],\n        [78.0300, 15.8400],\n        [78.0300, 15.8200]\n      ]\n    ]\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/delivery/zones",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "delivery", "zones"]
            }
          }
        },
        {
          "name": "Get All Delivery Zones (Paginated)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/delivery/zones?page=0&size=20&search=Kurnool",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "delivery", "zones"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "20" },
                { "key": "search", "value": "Kurnool" }
              ]
            }
          }
        },
        {
          "name": "Get Zone by Public ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/delivery/zones/{{zoneId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "delivery", "zones", "{{zoneId}}"]
            }
          }
        },
        {
          "name": "Update Delivery Zone (With PIN Code Clear / Update)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"zoneName\": \"Kurnool Prime Zone\",\n  \"description\": \"Expanded prime area delivery\",\n  \"city\": \"Kurnool\",\n  \"state\": \"Andhra Pradesh\",\n  \"pincode\": \"518001\",\n  \"pincodes\": [\"518001\", \"518002\", \"518003\"],\n  \"clearPincode\": false,\n  \"deliveryCharge\": 35.00,\n  \"minimumOrderAmount\": 249.00,\n  \"freeDeliveryThreshold\": 599.00,\n  \"estimatedDeliveryTime\": \"SAME_DAY\",\n  \"active\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/delivery/zones/{{zoneId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "delivery", "zones", "{{zoneId}}"]
            }
          }
        },
        {
          "name": "Deactivate Delivery Zone (Status Patch)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"active\": false\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/delivery/zones/{{zoneId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "delivery", "zones", "{{zoneId}}", "status"]
            }
          }
        },
        {
          "name": "Activate Delivery Zone (Status Patch)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"active\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/delivery/zones/{{zoneId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "delivery", "zones", "{{zoneId}}", "status"]
            }
          }
        },
        {
          "name": "Delete Delivery Zone (Soft Delete)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/delivery/zones/{{zoneId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "delivery", "zones", "{{zoneId}}"]
            }
          }
        }
      ]
    },
    {
