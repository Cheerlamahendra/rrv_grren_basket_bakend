              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productPublicId\": \"{{productPublicId1}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/wishlist/items",
              "host": ["{{baseUrl}}"],
              "path": ["api", "wishlist", "items"]
            }
          }
        },
